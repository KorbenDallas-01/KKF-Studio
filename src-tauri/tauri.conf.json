
{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KKF Studio",
  "version": "0.1.0",
  "identifier": "pl.kkfstudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KKF Studio v0.1.1",
        "width": 760,
        "height": 850,
        "minWidth": 690,
        "minHeight": 650,
        "backgroundColor": "#101116"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../helper/publish/*": "helper/",
      "../assets/KKF.docx": "assets/KKF.docx"
    }
  }
}
